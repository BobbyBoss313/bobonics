{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "bobonics",
  "compatibility_date": "2026-09-12",
  "assets": {
    "directory": ".",
    "not_found_handling": "404-page"
  },
  "routes": [
    {
      "pattern": "bobonics.com",
      "custom_domain": true
    },
    {
      "pattern": "www.bobonics.com",
      "custom_domain": true
    }
  ]
}
